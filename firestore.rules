rules_version = '2';

/**
 * Firestore Security Rules for GenoGraph Pro
 * 🏗️ ARCH REFERENCE: CP-008-Firestore-Security-Rules
 * 
 * Security Model:
 * - Users can only read/write their own data
 * - Genograms belong to a single user (owner)
 * - Persons and relationships are sub-documents (inherited permissions)
 * - No cross-user access allowed
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Users Collection
    // ============================================
    match /users/{uid} {
      // Only the authenticated user can read/write their own user document
      allow read, write: if request.auth.uid == uid;
      
      // ============================================
      // Genograms Sub-collection
      // ============================================
      match /genograms/{genogramId} {
        // Only the owner (uid) can read/write their genograms
        allow read, write: if request.auth.uid == uid;
        
        // ============================================
        // Persons Sub-collection (nested in genogram)
        // ============================================
        match /persons/{personId} {
          // Inherited from parent: only owner can access
          allow read, write: if request.auth.uid == uid;
          
          // Additional validation: ensure person data is valid
          allow write: if request.resource.data.size() > 0
            && request.resource.data.keys().hasAll(['name', 'gender']);
        }
        
        // ============================================
        // Relationships Sub-collection (nested in genogram)
        // ============================================
        match /relationships/{relationshipId} {
          // Inherited from parent: only owner can access
          allow read, write: if request.auth.uid == uid;
          
          // Additional validation: ensure required fields
          allow write: if request.resource.data.size() > 0
            && request.resource.data.keys().hasAll(['sourceId', 'targetId', 'relationType']);
        }
      }
    }
    
    // ============================================
    // Deny all other access (default deny)
    // ============================================
    // Any other path is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

/**
 * Firestore Security Rules for GenoGraph Pro
 * 🏗️ ARCH REFERENCE: CP-008-Firestore-Security-Rules (ENHANCED)
 * 
 * Security Model:
 * - Users can only read/write their own data
 * - Genograms belong to a single user (owner)
 * - Persons and relationships are sub-documents (inherited permissions)
 * - Strict type validation for all fields
 * - No cross-user access allowed
 * 
 * Enums Validated:
 * - Person.gender: ['male', 'female', 'other', 'unknown']
 * - Relationship.relationType: ['parent', 'child', 'spouse', 'sibling', 'extended']
 */

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // Users Collection
    // ============================================
    match /users/{uid} {
      // Only the authenticated user can read/write their own user document
      allow read, write: if request.auth.uid == uid;
      
      // ============================================
      // Genograms Sub-collection
      // ============================================
      match /genograms/{genogramId} {
        // Only the owner (uid) can read/write their genograms
        allow read, write: if request.auth.uid == uid;
        
        // ============================================
        // Persons Sub-collection (nested in genogram)
        // ============================================
        match /persons/{personId} {
          // Inherited from parent: only owner can access
          allow read, write: if request.auth.uid == uid;
          
          // Comprehensive validation for person data
          allow write: if request.resource.data.size() > 0
            // Required fields present
            && request.resource.data.keys().hasAll(['name', 'gender'])
            // Type validation
            && request.resource.data.name is string
            && request.resource.data.gender is string
            && request.resource.data.id is string
            // Field length constraints
            && request.resource.data.name.size() <= 100
            && request.resource.data.gender.size() <= 20
            // Enum validation for gender
            && request.resource.data.gender in ['male', 'female', 'other', 'unknown']
            // Optional fields type check if present
            && (!('birthDate' in request.resource.data) || request.resource.data.birthDate is string)
            && (!('deathDate' in request.resource.data) || request.resource.data.deathDate is string)
            && (!('notes' in request.resource.data) || request.resource.data.notes is string)
            && (!('notes' in request.resource.data) || request.resource.data.notes.size() <= 500);
        }
        
        // ============================================
        // Relationships Sub-collection (nested in genogram)
        // ============================================
        match /relationships/{relationshipId} {
          // Inherited from parent: only owner can access
          allow read, write: if request.auth.uid == uid;
          
          // Comprehensive validation for relationship data
          allow write: if request.resource.data.size() > 0
            // Required fields present
            && request.resource.data.keys().hasAll(['sourceId', 'targetId', 'relationType'])
            // Type validation
            && request.resource.data.sourceId is string
            && request.resource.data.targetId is string
            && request.resource.data.relationType is string
            && request.resource.data.id is string
            // Field length constraints
            && request.resource.data.sourceId.size() <= 50
            && request.resource.data.targetId.size() <= 50
            && request.resource.data.relationType.size() <= 30
            // Enum validation for relationType
            && request.resource.data.relationType in ['parent', 'child', 'spouse', 'sibling', 'extended']
            // Optional field type check if present
            && (!('label' in request.resource.data) || request.resource.data.label is string)
            && (!('label' in request.resource.data) || request.resource.data.label.size() <= 100);
        }
      }
    }
    
    // ============================================
    // Deny all other access (default deny)
    // ============================================
    // Any other path is denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

